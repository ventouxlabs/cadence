# .env is a hard requirement here: secrets arrive through env_file at runtime and must never be
# baked into a layer, where they would survive in the image history (PRP-09 risk 2).
.env
.env.*

# The live database and its backups belong to the host bind mount, never to the image.
data/

.git/
.github/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage
.coverage.*
coverage.xml

tests/
docs/
*.md
!README.md

node_modules/
test-results/
playwright-report/
.shots/
.omc/
.pre-commit-config.yaml
Makefile
