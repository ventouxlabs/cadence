# Copy to .env and fill in the tokens. .env is git-ignored and must never be committed.

# --- Cadence -----------------------------------------------------------------
# dev | test | prod. prod refuses a mocked integration at startup (D-139).
#
# Ships as prod because the one thing this file is copied to become is VM-201's .env, and an
# unedited copy must fail safe. dev here would have been silent: nothing warns about it, and
# the effect is only visible later as a mode that should have been refused (D-203). Set this
# to dev on a workstation, or use `make dev-docker`, which layers docker-compose.dev.yml.
CADENCE_ENV=prod
CADENCE_DB_PATH=data/cadence.db
CADENCE_HOST=0.0.0.0
CADENCE_PORT=8090
# live | mock - mock short-circuits the VitalForge client (PRP-06) and the smoke script (PRP-09)
CADENCE_VITALFORGE_MODE=live
# The in-process 5-minute drain and metrics refresh. 0 turns it off (D-140).
CADENCE_PERIODIC_SYNC=1
# Display only. Garmin wall-clock conversion happens in VitalForge, with VitalForge's own TZ.
TZ=Europe/Paris

# --- VitalForge --------------------------------------------------------------
VITALFORGE_WEIGHT_URL=https://weight.grepon.cc
VITALFORGE_DASHBOARD_URL=https://health.grepon.cc
VITALFORGE_TOKEN=
# Person path slugs (D-017). Editable later in Settings.
VITALFORGE_PERSON_ME=
VITALFORGE_PERSON_SON=

# --- OmniRoute (LLM gateway) -------------------------------------------------
# live | mock - mock returns a canned workout so the deploy smoke test needs no key (PRP-08)
CADENCE_OMNIROUTE_MODE=live
OMNIROUTE_URL=https://llm.grepon.cc/v1
OMNIROUTE_KEY=
OMNIROUTE_MODEL_GENERATE=code-plan
OMNIROUTE_MODEL_SUMMARY=cheap-think
