# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
htmlcov/
.coverage
coverage.xml

# Secrets & local data
#
# `.env*`, not `.env`: the dotenv convention spreads (.env.local, .env.production, .env.vm-201),
# and a variant that is not listed is tracked silently - the failure only shows up once a real
# VITALFORGE_TOKEN is already in the history. The allow-list entry below is what keeps the one
# file that must stay tracked (D-205). .dockerignore already covered both forms.
.env*
!.env.example
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/backups/

# Node / Playwright
node_modules/
test-results/
playwright-report/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# OMC state
.omc/
data/

# Screenshots from the end-to-end suite
.shots/

# coverage shards
.coverage.*
.shots/

# codemap scan reports
.reports/
